{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "types": [
      "@sapui5/types",
      "@types/qunit"
    ],
    "paths": {
      "de/itsfullofstars/gr/test/flp/plugin/*": [
        "./webapp/*"
      ],
      "unit/*": [
        "./webapp/test/unit/*"
      ],
      "integration/*": [
        "./webapp/test/integration/*"
      ]
    }
  },
  "exclude": [
    "./webapp/test/e2e/**/*"
  ],
  "include": [
    "./webapp/**/*"
  ]
}