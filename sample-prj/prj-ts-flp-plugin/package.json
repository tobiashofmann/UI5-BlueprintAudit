{
  "name": "de.itsfullofstars.gr.test.flp.plugin",
  "version": "1.0.0",
  "description": "Fiori Plugin: de.itsfullofstars.gr.test.flp.plugin",
  "author": "Tobias Hofmann",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "ui5 build --clean-dest",
    "build:opt": "ui5 build self-contained --clean-dest --all",
    "start": "ui5 serve --port 8080 --config ui5-test.yaml -o test/flpSandbox.html",
    "ts-typecheck": "tsc --noEmit",
    "lint": "eslint webapp",
    "ui5lint": "ui5lint",
    "test-ui5": "ui5-test-runner --start start-coverage --url http://localhost:8080/test/testsuite.qunit.html --coverage -ccb 50 -ccf 50 -ccl 50 -ccs 50",
    "test": "npm run lint && npm run test-ui5",
    "wdi5": "wdio run ./webapp/test/e2e/wdio.conf.ts"
  },
  "devDependencies": {
    "@openui5/types": "^1.153.0",
    "@sapui5/types": "1.153.0",
    "@ui5/cli": "^4.0.60",
    "@ui5/linter": "^1.23.4",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.9.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "ui5-middleware-livereload": "^3.3.1",
    "ui5-tooling-transpile": "^3.12.0",
    "wdio-ui5-service": "^3.0.12"
  }
}