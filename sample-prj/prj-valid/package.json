{
  "name": "prj-valid",
  "version": "0.0.1",
  "description": "Fixture project for ui5-blueprint-audit: fulfills every rule in the catalog",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sapui5/types": "~1.153.0",
    "ui5-tooling-transpile": "^3.10.0",
    "typescript": "^7.0.2",
    "rimraf": "^6.1.3",
    "wdio-ui5-service": "^3.0.0",
    "@wdio/cli": "^10.1.0",
    "@playwright/test": "^1.48.0"
  },
  "scripts": {
    "start": "fiori run --open \"/test/flpSandbox.html?sap-ui-xx-viewCache=false#sample-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "ts-typecheck": "tsc --noEmit",
    "prestart": "npm run ts-typecheck",
    "prebuild": "npm run ts-typecheck",
    "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:playwright": "playwright test"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}
