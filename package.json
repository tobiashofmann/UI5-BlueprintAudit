{
  "name": "ui5-blueprint-audit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Tobias Hofmann",
    "url": "https://www.itsfullofstars.de"
  },
  "homepage": "https://github.com/tobiashofmann/UI5-BlueprintAudit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiashofmann/UI5-BlueprintAudit.git"
  },
  "bugs": {
    "url": "https://github.com/tobiashofmann/UI5-BlueprintAudit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:junit:html": "npm run test:junit && npx xunit-viewer --results=test-results/junit.xml --output=test-results/junit.html",
    "test:allure": "rimraf allure-results && vitest run --config vitest.config.allure.ts",
    "report:allure": "npm run test:allure && allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "lint": "eslint .",
    "mutation": "stryker run",
    "typecheck": "tsc --build",
    "clean": "rimraf --glob coverage test-results allure-results allure-report ui5-blueprint-audit-report docs/api sbom reports .stryker-tmp \"packages/*/dist\" \"*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\"",
    "sbom": "rimraf sbom && node scripts/generate-sboms.mjs",
    "docs:api": "rimraf docs/api && typedoc"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^9.9.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/runner": "^4.1.11",
    "allure": "^3.22.1",
    "allure-vitest": "^3.14.0",
    "eslint": "^9.9.0",
    "globals": "^14.0.0",
    "rimraf": "^6.1.3",
    "typedoc": "0.28.20",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
