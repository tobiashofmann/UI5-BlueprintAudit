{
  "name": "ui5-blueprint-audit-monorepo",
  "private": true,
  "type": "module",
  "author": {
    "name": "Tobias Hofmann",
    "url": "https://www.itsfullofstars.de"
  },
  "homepage": "https://github.com/tobiashofmann/UI5-BlueprintAudit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiashofmann/UI5-BlueprintAudit.git"
  },
  "bugs": {
    "url": "https://github.com/tobiashofmann/UI5-BlueprintAudit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:junit:html": "npm run test:junit && npx xunit-viewer --results=test-results/junit.xml --output=test-results/junit.html",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "clean": "rimraf --glob coverage test-results ui5-blueprint-audit-report \"packages/*/dist\" \"*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}